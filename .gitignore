.DS_Store
.envrc
*.swp
.worktrees/
.claude/
.superpowers/
/.task/
/.sealed-secrets-keypair/

# Paivot runtime state (managed by pvg)
.vault/issues/
.vault/.nd.yaml
.vault/.piv-loop-state.json
.vault/.piv-loop-snapshot.json
.vault/.dispatcher-state.json
.vault/.vlt.lock
.vault/.guard/

# Terraform: never commit state, credentials, or kubeconfigs
terraform/clusters/.terraform/
terraform/clusters/*.tfstate
terraform/clusters/*.tfstate.*
terraform/clusters/*.tfvars
!terraform/clusters/*.tfvars.example
terraform/clusters/.kubeconfigs/
